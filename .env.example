# === Core ===
ENV=dev
LOG_LEVEL=INFO

# ===  Dataset ===
HF_TOKEN=

# === Vector store / Embeddings ===
CHROMA_DB_PATH=.chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# === LLM / RAG ===
# Frontier Agent provider: openai (gpt-4o-mini) | deepseek (deepseek-chat) | claude (claude-haiku-4-5)
# If unset: deepseek when DEEPSEEK_API_KEY is set, otherwise openai.
FRONTIER_PROVIDER=openai
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# === Pushover Notification settings ===
PUSHOVER_USER=
PUSHOVER_TOKEN=
